# Copie este arquivo para .env.local e preencha com as chaves reais do projeto
# Supabase (Project Settings > API, no painel do projeto hub-arruda).
# .env.local nunca é commitado (ver .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://mzvaqjhalynaceecnayt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (envio de e-mail — nutrição pós-perda e e-mail de boas-vindas).
# Painel Resend > API Keys. Domínio de envio (arrudacred.com.br) já verificado em 15/08/2026.
RESEND_API_KEY=

# URL pública do próprio Hub Arruda — usada pra montar o link de descadastro nos e-mails.
# Trocar pro domínio real assim que o deploy na Vercel existir (hoje só localhost faz sentido).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Zapster (WhatsApp — Fase 7). Painel Zapster > Meus Tokens (conta) e Instâncias (ID da instância).
ZAPSTER_API_BASE_URL=https://api.zapsterapi.com/v1
ZAPSTER_API_TOKEN=
ZAPSTER_INSTANCE_ID=
# Segredo nosso, qualquer string aleatória — confirma que quem chamou o endpoint de webhook fomos
# nós mesmos configurando a URL na Zapster com esse valor. Se vazio, a checagem é pulada (dev local).
ZAPSTER_WEBHOOK_SECRET=

# Protege /api/cron/followups. Vazio localmente pula a checagem (dev); em produção precisa estar
# configurado — o mesmo valor vai no header customizado do job criado no cron-job.org.
CRON_SECRET=

# Assinafy (assinatura eletrônica de contrato — Vendas). Doc completa em
# docs/api_reference/Assinafy-API-Reference.md. O Luiz já tem conta — a chave chega quando o
# adapter estiver pronto pra plugar (Coordenador entrega), não contratar/gastar crédito sozinho.
ASSINAFY_API_KEY=
ASSINAFY_ACCOUNT_ID=
ASSINAFY_BASE_URL=https://api.assinafy.com.br/v1
# Assinafy não assina webhook nativamente — o segredo vai como query param na URL cadastrada no
# painel deles (mesmo padrão do ZAPSTER_WEBHOOK_SECRET). Vazio localmente pula a checagem.
ASSINAFY_WEBHOOK_SECRET=

# Asaas (cobrança/pagamento — Vendas). Doc oficial: https://docs.asaas.com/llms.txt (sempre
# atualizada, sem arquivo local). O Luiz já tem conta — mesma regra do Assinafy acima.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
# Asaas TEM autenticação nativa de webhook por header (asaas-access-token) — não precisa de query
# param como o Zapster/Assinafy. Configurado por nós ao criar o webhook via POST /v3/webhooks.
ASAAS_WEBHOOK_SECRET=
